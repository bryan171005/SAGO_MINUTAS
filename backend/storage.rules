rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Las fotos de minutas se sirven por URL pública; solo el backend
    // (Admin SDK) puede subirlas o borrarlas.
    match /fotos/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
