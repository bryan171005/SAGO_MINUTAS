# ==========================================================
#  SAGO API - plantilla de variables de entorno
#  Copiar a .env y ajustar los valores locales:
#     PowerShell:  Copy-Item .env.example .env
#  .env NO se versiona (esta en .gitignore).
#  Este archivo SI se versiona: no pongas secretos reales.
# ==========================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- Firebase (se usa a partir del WP2) ---
FIREBASE_PROJECT_ID=sago-minutas
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Opcional: si se deja vacio se usa <FIREBASE_PROJECT_ID>.appspot.com.
# En proyectos nuevos el bucket suele ser <project>.firebasestorage.app: indicalo aqui.
FIREBASE_STORAGE_BUCKET=

# --- Autorizacion ---
ADMIN_EMAILS=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
